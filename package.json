{
  "name": "veloce-ui-workspace",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace veloce-docs",
    "build:ui": "npm run build --workspace @veloce/ui",
    "build:docs": "npm run build --workspace veloce-docs",
    "build": "npm run build:ui && npm run build:docs",
    "test": "npm run test --workspace @veloce/ui"
  }
}
